{
  "name": "taberna-don-juan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:official": "node scripts/import-official-media.mjs",
    "assets:fonts": "node scripts/import-fonts.mjs",
    "predev": "npm run assets:icons",
    "dev": "next dev",
    "prebuild": "npm run assets:icons",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:admin": "playwright test --config=playwright.admin.config.ts",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.71.2",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@electric-sql/pglite": "^0.5.16",
    "@next/env": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }

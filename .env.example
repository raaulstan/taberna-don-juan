# Copiar a .env.local. Nunca guardar valores privados en NEXT_PUBLIC_*.
# Usar el origen real del despliegue en producción (sin rutas).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: origen del panel, sin ruta. /admin funciona en el mismo despliegue.
NEXT_PUBLIC_ADMIN_URL=
# Activar la publicación del CMS solo después de migrar y revisar los datos.
PUBLIC_DATA_SOURCE=local

# Login de producción: Redis REST compartido y sal privada aleatoria (>=32 caracteres).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=

# Supabase > Project Settings > API. La publishable key es pública;
# los permisos los controla RLS. No usar service_role ni secret keys aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Requiere un dominio remitente verificado en Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
